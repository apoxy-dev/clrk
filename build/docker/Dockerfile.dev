# syntax=docker/dockerfile:1.6
# Minimal image used by `clrk dev --watch`. The binary is supplied via a host
# bind-mount — this image provides only the runtime userland (tini, iptables,
# libseccomp) required by both controller-manager and worker.
FROM debian:bookworm-slim

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends \
        ca-certificates \
        iptables \
        libseccomp2 \
        tini && \
    rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/usr/bin/tini", "--"]
