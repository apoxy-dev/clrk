# syntax=docker/dockerfile:1.6
# Stage 1: builder — compiles controller-manager with CGO enabled for kine/SQLite.
FROM golang:1.24-bookworm AS builder

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=1 GOOS=linux
RUN go build -o /out/controller-manager ./cmd/controller-manager

# Stage 2: runtime — slim debian with tini for PID 1 signal handling.
FROM debian:bookworm-slim

RUN apt-get update -qq && \
    apt-get install -qq -y --no-install-recommends \
        ca-certificates \
        tini && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/controller-manager /usr/local/bin/controller-manager

USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/controller-manager"]
